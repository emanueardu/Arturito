<?xml version="1.0"?>
<package format="3">
  <name>robertito</name>
  <version>0.1.0</version>
  <description>ROS 2 nodes for bridging the Arturito ESP32 firmware over UART and driving OLED eyes expressions.</description>
  <maintainer email="robot@example.com">Arturito Maintainers</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>sensor_msgs_py</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>python3-serial</exec_depend>
  <exec_depend>python3-pil</exec_depend>
  <exec_depend>python3-luma-oled</exec_depend>
  <exec_depend>image_transport</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>vision_msgs</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-requests</exec_depend>
  <exec_depend>python3-speechrecognition</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
